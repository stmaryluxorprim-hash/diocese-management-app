# Local Cloudflare preview (`npm run cf:preview`) reads runtime variables from
# `.dev.vars` (git-ignored). Copy this file to `.dev.vars` and fill it in —
# the same keys as .env.example. Supabase values are read at runtime only
# (no build-time copy needed).
NEXTJS_ENV=development
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
CRON_SECRET=
